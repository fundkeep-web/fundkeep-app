# ==============================================================================
# FundKeep App - Environment Variables
# Copy this file to .env.local: cp .env.example .env.local
# Note: All NEXT_PUBLIC_ variables are exposed to client-side code.
# ==============================================================================

# The deployed FundKeep Soroban contract address (Required)
NEXT_PUBLIC_CONTRACT_ID=CBYUMUNDBGT5JTYX62SSFH5NTK2ELLRT2PP3LLZOI757JB4BULDDDFAH

# The Stellar Asset Contract (SAC) address of the token being saved (e.g., USDC) (Required)
# Verify against Testnet before using; stale or invalid addresses cause transaction failures.
NEXT_PUBLIC_USDC_CONTRACT_ID=CBIELTK6YBZJU5UP2WWQEUCYJLPU6QXNBDCL34GQRH4LVRW7Q2N76226

# Target Stellar network (testnet supported in v1) (Required)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Soroban RPC endpoint for network communication (Required)
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Base URL of a running fundkeep-indexer instance (Optional)
# Optional for local development; needed for cross-device goal sync and activity feed
# NEXT_PUBLIC_INDEXER_URL=http://localhost:4000
